# Names only. Never commit real values. Use a Supabase project dedicated to PNG Alert (never the marketplace project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Do not prefix with NEXT_PUBLIC_. Bypasses RLS, so keep it out of the browser and out of git.
SUPABASE_SERVICE_ROLE_KEY=
# Accounts are required to report by default. Set to "true" to allow anonymous reports (rate limits still apply).
ALLOW_ANONYMOUS_REPORTS=false
